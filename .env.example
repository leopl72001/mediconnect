# Copia a .env y CAMBIA todos los valores antes de levantar Docker.
# No incluyas caracteres reservados de URL en contrasenas Mongo sin codificarlos.
POSTGRES_DB=mediconnect2
POSTGRES_USER=mediconnect2
POSTGRES_PASSWORD=replace-this-postgres-password
MONGO_ROOT_USERNAME=mediconnect2
MONGO_ROOT_PASSWORD=replace-this-mongo-password
JWT_SECRET=replace-this-with-a-random-unique-secret-of-at-least-64-bytes-before-running-the-app
DEV_ADMIN_EMAIL=admin@local.test
DEV_ADMIN_PASSWORD=replace-this-admin-password
