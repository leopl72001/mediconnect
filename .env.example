# Copia a .env SOLO cuando pases a la fase de Docker.
# Cambia estas credenciales antes de iniciar contenedores.
POSTGRES_DB=mediconnect2
POSTGRES_USER=mediconnect2
POSTGRES_PASSWORD=change-this-local-password
MONGO_ROOT_USERNAME=mediconnect2
MONGO_ROOT_PASSWORD=change-this-mongo-password

# Perfil prod local (requiere esquema SQL migrado/creado previamente)
DB_URL=jdbc:postgresql://localhost:5433/mediconnect2
DB_USERNAME=mediconnect2
DB_PASSWORD=change-this-local-password
MONGO_URI=mongodb://mediconnect2:change-this-mongo-password@localhost:27018/mediconnect2?authSource=admin
REDIS_HOST=localhost
REDIS_PORT=6380
JWT_SECRET=replace-this-with-a-random-secret-of-at-least-64-bytes-before-prod
